# ===========================================
# SPOOLED BACKEND - Environment Configuration
# ===========================================
# Copy this file to .env and update values
# For Portainer: Add these as environment variables in the stack

# ===========================================
# REQUIRED - Must be set
# ===========================================

# Database password (generate a strong random password)
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=your-super-secure-postgres-password-here

# JWT Secret - minimum 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars

# Cloudflare Tunnel Token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# ===========================================
# RECOMMENDED - Change from defaults
# ===========================================

# Grafana admin password (default: admin) - CHANGE THIS!
# Generate with: openssl rand -base64 16
GRAFANA_PASSWORD=your-secure-grafana-password

# Base URL for your deployment
BASE_URL=https://api.spooled.cloud

# Grafana public URL (for OAuth redirects, etc.)
GRAFANA_URL=https://grafana.spooled.cloud

# ===========================================
# EMAIL CONFIGURATION (for passwordless login)
# ===========================================

# Email provider: resend, sendgrid, postmark, smtp, or console (dev only)
EMAIL_PROVIDER=console

# API key for email provider (Resend, SendGrid, Postmark)
# EMAIL_API_KEY=re_xxxxxxxxxxxx

# From address for outgoing emails
EMAIL_FROM_ADDRESS=noreply@spooled.cloud

# From name for outgoing emails
EMAIL_FROM_NAME="Spooled Cloud"

# SMTP settings (only if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# ===========================================
# STRIPE BILLING CONFIGURATION
# ===========================================

# Stripe secret key (from Stripe Dashboard > Developers > API keys)
# Use sk_test_xxx for testing, sk_live_xxx for production
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Stripe webhook signing secret (from Stripe Dashboard > Developers > Webhooks)
# This is for the /api/v1/billing/webhook endpoint
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Stripe Price IDs for subscription plans
# Create products in Stripe and copy the price IDs
# STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxx
# STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxx

# Optional: Stripe Billing Portal configuration ID
# Create in Stripe Dashboard > Settings > Billing > Customer portal
# STRIPE_BILLING_PORTAL_CONFIG_ID=bpc_xxxxxxxxxxxx

# ===========================================
# WEBHOOK SECRETS (for incoming webhooks)
# ===========================================

# GitHub webhook secret (for /api/v1/webhooks/{org_id}/github)
# Generate with: openssl rand -base64 32
# GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Stripe webhook secret (for /api/v1/webhooks/{org_id}/stripe - job webhooks)
# This is different from STRIPE_BILLING_WEBHOOK_SECRET
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ===========================================
# OPTIONAL - Server Configuration
# ===========================================

# Docker image (automatically uses multi-arch latest)
# BACKEND_IMAGE=ghcr.io/spooled-cloud/spooled-backend:latest

# Host and port bindings
# HOST=0.0.0.0
# PORT=8080
# METRICS_PORT=9090

# Database settings
# POSTGRES_USER=spooled
# POSTGRES_DB=spooled

# Database URL (constructed automatically in Docker, set manually otherwise)
# DATABASE_URL=postgres://spooled:password@localhost:5432/spooled

# Direct database URL (bypasses PgBouncer, used for migrations)
# DATABASE_DIRECT_URL=postgres://spooled:password@localhost:5432/spooled

# Redis URL
# REDIS_URL=redis://localhost:6379

# Redis password (optional but recommended)
# REDIS_PASSWORD=your-redis-password

# Environment: development, staging, production
# RUST_ENV=production

# ===========================================
# OPTIONAL - Performance Tuning
# ===========================================

# Database connection pool
# DATABASE_MAX_CONNECTIONS=25
# DATABASE_MIN_CONNECTIONS=5
# DATABASE_ACQUIRE_TIMEOUT_SECS=30

# Redis connection pool
# REDIS_POOL_SIZE=10

# JWT settings
# JWT_EXPIRATION_HOURS=24

# Queue settings
# QUEUE_DEFAULT_TIMEOUT_SECS=300
# QUEUE_DEFAULT_MAX_RETRIES=3
# QUEUE_MAX_PAYLOAD_SIZE_BYTES=1048576

# Worker settings
# WORKER_HEARTBEAT_INTERVAL_SECS=10
# WORKER_LEASE_DURATION_SECS=30
# WORKER_MAX_CONCURRENCY=5
# WORKER_FALLBACK_POLL_INTERVAL_SECS=5

# Rate limiting
# RATE_LIMIT_REQUESTS_PER_SECOND=100
# RATE_LIMIT_BURST_SIZE=200

# Logging
# RUST_LOG=info,tower_http=info
# JSON_LOGS=true

# ===========================================
# OPTIONAL - Monitoring
# ===========================================
# Prometheus & Grafana are deployed by default

# Grafana admin username
# GRAFANA_USER=admin

# OpenTelemetry (distributed tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_SERVICE_NAME=spooled-backend

# ===========================================
# OPTIONAL - Admin Tools (use: docker compose --profile admin up)
# ===========================================

# pgAdmin credentials
# PGADMIN_EMAIL=admin@spooled.cloud
# PGADMIN_PASSWORD=admin

# ===========================================
# REGISTRATION MODE (SaaS vs Self-hosted)
# ===========================================

# Registration mode controls who can create organizations:
# - "open": Anyone can create organizations (default, for self-hosted)
# - "closed": Only admin can create organizations (for SaaS)
# - "invite": Require invite code (future feature)
REGISTRATION_MODE=open

# Admin API key for creating organizations when REGISTRATION_MODE=closed
# Generate with: openssl rand -base64 32
# Use this key in X-Admin-Key header when creating organizations
# ADMIN_API_KEY=your-admin-api-key-here
