# =============================================================================
# SPOOLED BACKEND - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in the values
# For production, use secure values and don't commit .env to git
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Host to bind (default: 0.0.0.0)
HOST=0.0.0.0

# HTTP API port (default: 8080)
PORT=8080

# Prometheus metrics port (default: 9090)
METRICS_PORT=9090

# Environment: development, staging, production
RUST_ENV=development

# Logging level (default: info)
# Options: trace, debug, info, warn, error
RUST_LOG=info,tower_http=info

# Enable JSON-formatted logs (recommended for production)
JSON_LOGS=false

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# Connection URL (via PgBouncer for production)
DATABASE_URL=postgres://spooled:spooled_password@localhost:6432/spooled

# Direct connection URL (bypasses PgBouncer, used for migrations)
DATABASE_DIRECT_URL=postgres://spooled:spooled_password@localhost:5432/spooled

# Connection pool settings
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=30

# =============================================================================
# REDIS (Cache & Pub/Sub)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Connection pool size
REDIS_POOL_SIZE=10

# =============================================================================
# SECURITY
# =============================================================================

# JWT signing secret (REQUIRED in production)
# Must be at least 32 characters with good entropy
# Generate with: openssl rand -base64 48
JWT_SECRET=development-secret-change-in-production

# JWT token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# CORS allow-list (comma-separated). In production the API never reflects the
# request Origin, so every browser origin that calls the API must be listed here
# — the marketing site and the dashboard SPA. Missing the dashboard origin
# CORS-blocks the whole dashboard (login included).
# Leave unset in development (any origin is allowed).
CORS_ALLOWED_ORIGINS=https://spooled.cloud,https://www.spooled.cloud,https://dashboard.spooled.cloud

# =============================================================================
# gRPC CONFIGURATION
# =============================================================================

# Enable TLS for gRPC server (required for Cloudflare Tunnel HTTPS origin)
GRPC_TLS_ENABLED=false

# Path to TLS certificate (PEM format)
GRPC_TLS_CERT_PATH=/path/to/grpc-cert.pem

# Path to TLS private key (PEM format)
GRPC_TLS_KEY_PATH=/path/to/grpc-key.pem

# =============================================================================
# RATE LIMITING
# =============================================================================

# Requests per second limit
RATE_LIMIT_REQUESTS_PER_SECOND=100

# When true, Redis missing/errors deny with 429 (hosted SaaS). Default false = fail-open for self-host without Redis.
# RATE_LIMIT_FAIL_CLOSED=true

# Burst size for rate limiting
RATE_LIMIT_BURST_SIZE=200

# When true, Redis missing/errors deny with 429 (hosted SaaS). Default false = fail-open for self-host without Redis.
# RATE_LIMIT_FAIL_CLOSED=true

# =============================================================================
# WORKER SETTINGS
# =============================================================================

# Heartbeat interval in seconds
WORKER_HEARTBEAT_INTERVAL_SECS=10

# Lease duration in seconds (job lock timeout)
WORKER_LEASE_DURATION_SECS=30

# Maximum concurrent jobs per worker
WORKER_MAX_CONCURRENCY=5

# Fallback poll interval when Redis unavailable
WORKER_FALLBACK_POLL_INTERVAL_SECS=5

# =============================================================================
# QUEUE SETTINGS
# =============================================================================

# Default max retries for jobs
QUEUE_DEFAULT_MAX_RETRIES=3

# Default job timeout in seconds
QUEUE_DEFAULT_TIMEOUT_SECS=300

# Maximum payload size in bytes (default: 1MB)
QUEUE_MAX_PAYLOAD_SIZE_BYTES=1048576



# =============================================================================
# PLAN LIMITS (Self-hosted overrides)
# =============================================================================
# Spooled enforces plan limits per organization (free/starter/pro/enterprise).
# You can override the built-in plan defaults via environment variables.
#
# Precedence (low -> high):
# 1) Built-in defaults
# 2) SPOOLED_PLAN_LIMITS_JSON (global tier map)
# 3) SPOOLED_PLAN_<TIER>_LIMITS_JSON (per-tier JSON)
# 4) SPOOLED_PLAN_<TIER>_<FIELD> (per-field overrides)
# 5) organizations.custom_limits (DB per-org override)
#
# NOTE: There are also hard caps enforced by request validation today.
# Increasing max_payload_size_bytes above these caps will NOT take effect until the caps are raised:
# - HTTP job payload validation: ~1MB
# - gRPC enqueue payload validation: 1MB
#
# Global JSON override (tier -> overrides). Optional limits use `null` for unlimited.
# (This example is the REAL built-in defaults from spooled-backend/src/config/plans.rs)
# SPOOLED_PLAN_LIMITS_JSON={"free":{"max_jobs_per_day":1000,"max_active_jobs":10,"max_queues":2,"max_workers":1,"max_api_keys":2,"max_schedules":1,"max_workflows":0,"max_webhooks":1,"max_payload_size_bytes":65536,"rate_limit_requests_per_second":5,"rate_limit_burst":10,"job_retention_days":3,"history_retention_days":1},"starter":{"max_jobs_per_day":10000,"max_active_jobs":500,"max_queues":10,"max_workers":5,"max_api_keys":5,"max_schedules":10,"max_workflows":5,"max_webhooks":5,"max_payload_size_bytes":262144,"rate_limit_requests_per_second":25,"rate_limit_burst":50,"job_retention_days":14,"history_retention_days":7},"pro":{"max_jobs_per_day":100000,"max_active_jobs":5000,"max_queues":50,"max_workers":25,"max_api_keys":25,"max_schedules":50,"max_workflows":25,"max_webhooks":20,"max_payload_size_bytes":1048576,"rate_limit_requests_per_second":100,"rate_limit_burst":200,"job_retention_days":30,"history_retention_days":30},"enterprise":{"max_jobs_per_day":null,"max_active_jobs":null,"max_queues":null,"max_workers":null,"max_api_keys":null,"max_schedules":null,"max_workflows":null,"max_webhooks":null,"max_payload_size_bytes":5242880,"rate_limit_requests_per_second":500,"rate_limit_burst":1000,"job_retention_days":90,"history_retention_days":90}}
#
# Per-tier JSON overrides (same schema as organizations.custom_limits)
# SPOOLED_PLAN_FREE_LIMITS_JSON={"max_jobs_per_day":1000,"max_active_jobs":10,"max_queues":2,"max_workers":1,"max_api_keys":2,"max_schedules":1,"max_workflows":0,"max_webhooks":1,"max_payload_size_bytes":65536,"rate_limit_requests_per_second":5,"rate_limit_burst":10,"job_retention_days":3,"history_retention_days":1}
# SPOOLED_PLAN_STARTER_LIMITS_JSON={"max_jobs_per_day":10000,"max_active_jobs":500,"max_queues":10,"max_workers":5,"max_api_keys":5,"max_schedules":10,"max_workflows":5,"max_webhooks":5,"max_payload_size_bytes":262144,"rate_limit_requests_per_second":25,"rate_limit_burst":50,"job_retention_days":14,"history_retention_days":7}
# SPOOLED_PLAN_PRO_LIMITS_JSON={"max_jobs_per_day":100000,"max_active_jobs":5000,"max_queues":50,"max_workers":25,"max_api_keys":25,"max_schedules":50,"max_workflows":25,"max_webhooks":20,"max_payload_size_bytes":1048576,"rate_limit_requests_per_second":100,"rate_limit_burst":200,"job_retention_days":30,"history_retention_days":30}
# SPOOLED_PLAN_ENTERPRISE_LIMITS_JSON={"max_jobs_per_day":null,"max_active_jobs":null,"max_queues":null,"max_workers":null,"max_api_keys":null,"max_schedules":null,"max_workflows":null,"max_webhooks":null,"max_payload_size_bytes":5242880,"rate_limit_requests_per_second":500,"rate_limit_burst":1000,"job_retention_days":90,"history_retention_days":90}
#
# Per-field overrides (highest precedence in env). Optional limits support: unlimited|none|null|-1
#
# --- FREE defaults ---
# SPOOLED_PLAN_FREE_MAX_JOBS_PER_DAY=1000
# SPOOLED_PLAN_FREE_MAX_ACTIVE_JOBS=10
# SPOOLED_PLAN_FREE_MAX_QUEUES=2
# SPOOLED_PLAN_FREE_MAX_WORKERS=1
# SPOOLED_PLAN_FREE_MAX_API_KEYS=2
# SPOOLED_PLAN_FREE_MAX_SCHEDULES=1
# SPOOLED_PLAN_FREE_MAX_WORKFLOWS=0
# SPOOLED_PLAN_FREE_MAX_WEBHOOKS=1
# SPOOLED_PLAN_FREE_MAX_PAYLOAD_SIZE_BYTES=65536
# SPOOLED_PLAN_FREE_RATE_LIMIT_RPS=5
# SPOOLED_PLAN_FREE_RATE_LIMIT_BURST=10
# SPOOLED_PLAN_FREE_JOB_RETENTION_DAYS=3
# SPOOLED_PLAN_FREE_HISTORY_RETENTION_DAYS=1
#
# --- STARTER defaults ---
# SPOOLED_PLAN_STARTER_MAX_JOBS_PER_DAY=10000
# SPOOLED_PLAN_STARTER_MAX_ACTIVE_JOBS=500
# SPOOLED_PLAN_STARTER_MAX_QUEUES=10
# SPOOLED_PLAN_STARTER_MAX_WORKERS=5
# SPOOLED_PLAN_STARTER_MAX_API_KEYS=5
# SPOOLED_PLAN_STARTER_MAX_SCHEDULES=10
# SPOOLED_PLAN_STARTER_MAX_WORKFLOWS=5
# SPOOLED_PLAN_STARTER_MAX_WEBHOOKS=5
# SPOOLED_PLAN_STARTER_MAX_PAYLOAD_SIZE_BYTES=262144
# SPOOLED_PLAN_STARTER_RATE_LIMIT_RPS=25
# SPOOLED_PLAN_STARTER_RATE_LIMIT_BURST=50
# SPOOLED_PLAN_STARTER_JOB_RETENTION_DAYS=14
# SPOOLED_PLAN_STARTER_HISTORY_RETENTION_DAYS=7
#
# --- PRO defaults ---
# SPOOLED_PLAN_PRO_MAX_JOBS_PER_DAY=100000
# SPOOLED_PLAN_PRO_MAX_ACTIVE_JOBS=5000
# SPOOLED_PLAN_PRO_MAX_QUEUES=50
# SPOOLED_PLAN_PRO_MAX_WORKERS=25
# SPOOLED_PLAN_PRO_MAX_API_KEYS=25
# SPOOLED_PLAN_PRO_MAX_SCHEDULES=50
# SPOOLED_PLAN_PRO_MAX_WORKFLOWS=25
# SPOOLED_PLAN_PRO_MAX_WEBHOOKS=20
# SPOOLED_PLAN_PRO_MAX_PAYLOAD_SIZE_BYTES=1048576
# SPOOLED_PLAN_PRO_RATE_LIMIT_RPS=100
# SPOOLED_PLAN_PRO_RATE_LIMIT_BURST=200
# SPOOLED_PLAN_PRO_JOB_RETENTION_DAYS=30
# SPOOLED_PLAN_PRO_HISTORY_RETENTION_DAYS=30
#
# --- ENTERPRISE defaults ---
# SPOOLED_PLAN_ENTERPRISE_MAX_JOBS_PER_DAY=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_ACTIVE_JOBS=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_QUEUES=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_WORKERS=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_API_KEYS=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_SCHEDULES=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_WORKFLOWS=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_WEBHOOKS=unlimited
# SPOOLED_PLAN_ENTERPRISE_MAX_PAYLOAD_SIZE_BYTES=5242880
# SPOOLED_PLAN_ENTERPRISE_RATE_LIMIT_RPS=500
# SPOOLED_PLAN_ENTERPRISE_RATE_LIMIT_BURST=1000
# SPOOLED_PLAN_ENTERPRISE_JOB_RETENTION_DAYS=90
# SPOOLED_PLAN_ENTERPRISE_HISTORY_RETENTION_DAYS=90

# =============================================================================
# REGISTRATION / AUTHENTICATION
# =============================================================================

# Registration mode:
# - "open": Anyone can create organizations (default, for self-hosted)
# - "closed": Only admin can create organizations (for SaaS)
# - "invite": Require invite code (future)
REGISTRATION_MODE=open

# Enable email-based signup (default: true)
EMAIL_SIGNUP_ENABLED=true

# Admin API key for creating orgs when mode is "closed"
# Also used for /api/v1/admin/* endpoints
ADMIN_API_KEY=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email provider: console, resend, sendgrid, postmark, smtp
EMAIL_PROVIDER=console

# API key for Resend/SendGrid/Postmark
EMAIL_API_KEY=

# From email address
EMAIL_FROM_ADDRESS=noreply@spooled.cloud

# From name
EMAIL_FROM_NAME=Spooled Cloud

# SMTP settings (only for smtp provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# STRIPE BILLING (Optional)
# =============================================================================

# Stripe secret key (sk_live_xxx or sk_test_xxx)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for billing events (whsec_xxx)
STRIPE_BILLING_WEBHOOK_SECRET=

# Stripe Price IDs for plans
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Stripe billing portal configuration ID (optional)
STRIPE_BILLING_PORTAL_CONFIG_ID=

# =============================================================================
# WEBHOOK SECRETS
# =============================================================================

# GitHub webhook secret (for incoming GitHub webhooks)
GITHUB_WEBHOOK_SECRET=

# Stripe webhook secret (for incoming Stripe webhooks - different from billing)
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# OBSERVABILITY (OpenTelemetry)
# =============================================================================

# OTLP endpoint for trace export (e.g., http://jaeger:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for tracing
OTEL_SERVICE_NAME=spooled-backend

# Metrics token for /metrics endpoint authentication (optional)
METRICS_TOKEN=

# =============================================================================
# CLOUDFLARE TUNNEL (Production)
# =============================================================================

# Cloudflare tunnel token (from Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=
